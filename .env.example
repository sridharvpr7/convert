# ============================================================
# CONVETER — Production & Development Environment Variables
# ============================================================

# Server Port (Render automatically sets PORT)
PORT=5000

# Public Application URL (used in Telegram deep links)
APP_URL=https://convetpulse.onrender.com

# ------------------------------------------------------------
# Telegram Bot Integration (Admin Notifications & Webhook)
# ------------------------------------------------------------
# Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Authorized Telegram Admin Chat ID or User ID (e.g. 123456789)
TELEGRAM_CHAT_ID=your_telegram_admin_chat_id_here
# Secret Token for verifying incoming webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------
# Razorpay Payment Integration (Server-Side HMAC SHA256)
# ------------------------------------------------------------
# Razorpay Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook secret for verifying payment webhook payloads
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------
# Firebase Authentication & Server-Side Token Verification
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
# Server-side Firebase ID token verification (set on Render environment):
FIREBASE_PROJECT_ID=your-project-id
