# ============================================================
# CONVET PULSE — Production & Development Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Never commit real API keys, passwords, or secrets to Git.
#
# IMPORTANT FOR GITHUB ACTIONS RELEASE BUILDS:
# Vite statically embeds all VITE_* variables into client bundles
# at compile time. Clean GitHub Actions runners do not have access
# to local .env.local files. You MUST configure the following secrets
# in GitHub Repository Settings -> Secrets and variables -> Actions:
#
#   1. VITE_FIREBASE_API_KEY
#   2. VITE_FIREBASE_AUTH_DOMAIN
#   3. VITE_FIREBASE_PROJECT_ID
#   4. VITE_FIREBASE_APP_ID
#   5. VITE_GOOGLE_DESKTOP_CLIENT_ID (required for Windows OAuth PKCE)
#
# ============================================================

# Server Port (Render automatically sets PORT)
PORT=5000

# Public Application URL (used in Telegram deep links & redirects)
APP_URL=https://convetpulse.onrender.com

# ------------------------------------------------------------
# Telegram Bot Integration (Admin Notifications & Webhook)
# ------------------------------------------------------------
# Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Razorpay Payment Integration (Server-Side HMAC SHA256)
# ------------------------------------------------------------
# Razorpay Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Firebase Authentication & Client-Side Configuration
# ------------------------------------------------------------
# Web API Key from Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here

# Firebase Auth Domain (e.g. conveter-89200.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=conveter-89200.firebaseapp.com

# Firebase Project ID (e.g. conveter-89200)
VITE_FIREBASE_PROJECT_ID=conveter-89200

# Firebase Web App ID (from Project Settings -> General -> Web Apps)
VITE_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Google OAuth 2.0 Desktop Client ID (Windows Desktop PKCE Flow)
# ------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Application type: Desktop App
VITE_GOOGLE_DESKTOP_CLIENT_ID=your_desktop_oauth_client_id.apps.googleusercontent.com
