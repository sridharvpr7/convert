# ============================================================
# CONVETER — Production & Development Environment Variables
# ============================================================

# Server Port (Render automatically sets PORT)
PORT=5000

# Public Application URL (used in Telegram deep links)
APP_URL=https://conveter-4rmd.onrender.com

# ------------------------------------------------------------
# Telegram Bot Integration (Admin Notifications & Webhook)
# ------------------------------------------------------------
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Authorized Telegram Admin Chat ID or User ID (e.g. 123456789)
TELEGRAM_CHAT_ID=
# Secret Token for verifying incoming webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Firebase Authentication (Optional — app works with local auth)
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
