{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CONVET PULSE",
  "version": "1.0.1",
  "identifier": "com.sridharvpr.convetpulse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CONVET PULSE",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://convetpulse.onrender.com; connect-src 'self' https://convetpulse.onrender.com https://*.firebaseio.com https://*.googleapis.com https://github.com https://*.githubusercontent.com; img-src 'self' blob: data: https:; font-src 'self' data: https:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRkI0MUUzQTlGMDhBOEQKUldTTml2Q3A0MEg3bXFrTWx4U2tNNlJwdDdOZFpWazhkdFhVZVFQaVRRd3kxaDR4OVZ6SHRMODMK",
      "endpoints": [
        "https://github.com/sridharvpr7/convert/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
  "active": true,
  "createUpdaterArtifacts": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "windows": {
    "nsis": {
      "displayLanguageSelector": false
    }
  },
  "android": {
    "debugApplicationIdSuffix": ".debug"
  }
}
}
